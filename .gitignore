 
```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Build folders
dist/
build/
coverage/
.next/
out/

# Vite
vite.svg

# Cache
.cache/
.parcel-cache/
.eslintcache

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-data/
postgres-data/
redis-data/

# Database
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/

# Uploads
uploads/

# Generated files
*.tgz

# Testing
coverage/

# Package managers
.pnpm-store/

# TypeScript
*.tsbuildinfo

# Misc
.env.backup
.env.old

# Python (por si mezclás herramientas)
__pycache__/
*.pyc

# Accidentally generated folders
{src/
```
